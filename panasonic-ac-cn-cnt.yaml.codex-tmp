defaults:
  panasonic_component_ref: feature/add-more-functions

external_components:
  - source:
      type: git
      url: https://github.com/PeterRill/esphome-panasonic-ac
      ref: ${panasonic_component_ref}
    components:
      - panasonic_ac
    refresh: 0s

climate:
  - platform: panasonic_ac
    id: panasonic_ac_climate
    # Ohne eigenen Namen verwendet HA den nummerierten Gerätenamen.
    name: ""

    # CN-CNT:
    type: cnt

    horizontal_swing_select:
      name: Horizontale Lamellenposition
      option_labels:
        auto: Automatisch
        left: Links
        left_center: Links-Mitte
        center: Mitte
        right_center: Rechts-Mitte
        right: Rechts

    vertical_swing_select:
      name: Vertikale Lamellenposition
      option_labels:
        swing: Schwenken
        auto: Automatisch
        up: Oben
        up_center: Oben-Mitte
        center: Mitte
        down_center: Unten-Mitte
        down: Unten

    outside_temperature:
      name: Outside Temperature

    defrost_sensor:
      name: Defrost Status

    nanoex_switch:
      name: Nanoe X

    current_power_consumption:
      name: Power Consumption

    operational_status:
      id: panasonic_ac_operational_status
      name: Operational Status

    indoor_humidity:
      name: Indoor Humidity

    # diagnostic_temperature_byte_21:
    #   name: Diagnostic Temperature Byte 21

    # eco_switch:
    #   name: Eco

    # econavi_switch:
    #   name: Econavi

    # mild_dry_switch:
    #   name: Mild Dry

